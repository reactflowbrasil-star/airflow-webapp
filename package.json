{
  "name": "airflow-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace transacional de serviços de ar-condicionado e climatização",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:financial": "vitest run tests/financial",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "icons": "node --experimental-strip-types scripts/generate-icons.mts",
    "gates": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "check:layout": "node --experimental-strip-types scripts/check-layout.mts",
    "test:e2e": "vitest run tests/e2e",
    "smoke": "tsx scripts/smoke-jornada.mts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@phosphor-icons/web": "2.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "jose": "6.2.8",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "prisma": "7.9.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.16.0"
}
