# Coolify/HatClaw production variables.
# Copy these into the application Environment Variables panel.

NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@host:5432/database"

# JWT/session secret. Use at least 32 random characters.
AUTH_SECRET=""

# Payment provider.
PAYMENT_PROVIDER="sandbox"
SANDBOX_WEBHOOK_SECRET=""

# n8n outbound events: backend -> n8n.
N8N_BASE_URL=""
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

# n8n inbound commands/jobs: n8n -> backend.
BACKEND_WEBHOOK_SECRET=""

# WhatsApp verification via Evolution API. Leave blank to keep sandbox behavior.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""

# Optional seed-only admin password.
ADMIN_INITIAL_PASSWORD=""
