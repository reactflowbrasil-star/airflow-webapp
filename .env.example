# Copie para .env e preencha.
DATABASE_URL="postgresql://user:password@host:5432/database"

# Chave de assinatura das sessões JWT (>= 32 bytes aleatórios)
AUTH_SECRET=""

# Provedor de pagamento ativo: sandbox | (futuros: mercadopago, asaas, ...)
PAYMENT_PROVIDER="sandbox"
SANDBOX_WEBHOOK_SECRET=""

# ── Integração n8n ─────────────────────────────────────────────────────────
# Base da instância n8n (orquestrador; nunca fonte de verdade)
N8N_BASE_URL=""
# Webhook de entrada de eventos no n8n (WF-01)
N8N_WEBHOOK_URL=""
# Segredo com que o BACKEND ASSINA eventos enviados ao n8n (backend -> n8n)
N8N_WEBHOOK_SECRET=""
# Segredo com que o n8n ASSINA chamadas ao backend (n8n -> backend)
BACKEND_WEBHOOK_SECRET=""

# ── Verificação por WhatsApp (Evolution API) ───────────────────────────────
# Base da instância, sem barra final. Ex.: https://evolution.hatclaw.run.place
EVOLUTION_API_URL=""
# Token da instância (header `apikey`). Pegue no manager, na instância usada
# como número oficial da plataforma.
EVOLUTION_API_KEY=""
# Sem estas duas, o envio cai no sandbox: nada é entregue e o log avisa.

# ── Painel administrativo ──────────────────────────────────────────────────
# Senha inicial do admin criado pelo seed (studioreactfly@gmail.com).
# Só é usada na CRIAÇÃO da conta — rodar o seed de novo não sobrescreve a
# senha já trocada. Defina algo forte aqui e troque no primeiro acesso.
ADMIN_INITIAL_PASSWORD=""
